#!/bin/sh
# SDD modo privado: recusa o push quando há marcas do SDD (IDs de spec e ADR, tags de teste, seções, caminho do spec_root).
# Instalado por `spec_graph.py private init` em .git/hooks (não versionado). Escape do próprio git: git push --no-verify
# A ferramenta é escolhida quando o hook roda: o caminho gravado no `private init`, senão tools/sdd/spec_graph.py da worktree.
recorded="__SDD_TOOL__"
top=$(git rev-parse --show-toplevel 2>/dev/null)
vendored="$top/tools/sdd/spec_graph.py"
if [ -f "$recorded" ]; then
  tool=$recorded
elif [ -n "$top" ] && [ -f "$vendored" ]; then
  tool=$vendored
else
  echo "pre-push: ferramenta do leak-check não encontrada — rode \`private init\` de novo (procurado: $recorded e $vendored)" >&2
  exit 1
fi
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0
while read -r _ local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  "__PYTHON__" "$tool" leak-check --range "$remote_sha..$local_sha" --branch "${remote_ref#refs/heads/}" || status=1
done
[ "$status" -eq 0 ] || echo "pre-push: marcas do SDD encontradas — remova-as antes de enviar ao time" >&2
exit $status
