#!/bin/sh
# SDD modo privado: recusa o push quando há marcas do SDD (IDs de spec e ADR, tags de teste, seções, caminho do spec_root).
# Instalado por `spec_graph.py private init` em .git/hooks (não versionado). Escape do próprio git: git push --no-verify
# A ferramenta é escolhida quando o hook roda, na primeira ref enviada: o caminho gravado no `private init`, senão
# tools/sdd/spec_graph.py da worktree desde que NÃO seja rastreado pelo git. Push que só apaga branches não a exige.
recorded="__SDD_TOOL__"
tool=
find_tool() {
  if [ -f "$recorded" ]; then
    tool=$recorded
    return 0
  fi
  top=$(git rev-parse --show-toplevel 2>/dev/null)
  vendored="$top/tools/sdd/spec_graph.py"
  if [ -n "$top" ] && [ -f "$vendored" ] &&
     ! git -C "$top" ls-files --error-unmatch -- tools/sdd/spec_graph.py >/dev/null 2>&1; then
    tool=$vendored
    echo "pre-push: leak-check com a ferramenta do projeto: $tool" >&2
    return 0
  fi
  echo "pre-push: ferramenta do leak-check não encontrada — rode \`private init\` de novo (procurado: $recorded e $vendored não rastreado)" >&2
  return 1
}
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0
while read -r _ local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ -z "$tool" ]; then
    find_tool || exit 1
  fi
  "__PYTHON__" "$tool" leak-check --range "$remote_sha..$local_sha" --branch "${remote_ref#refs/heads/}" || status=1
done
[ "$status" -eq 0 ] || echo "pre-push: marcas do SDD encontradas — remova-as antes de enviar ao time" >&2
exit $status
