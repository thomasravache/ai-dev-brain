[
  {
    "metadata": {"name": "dev-account", "namespace": "argocd"},
    "spec": {
      "project": "core",
      "source": {
        "repoURL": "https://charts.interno/helm",
        "chart": "account",
        "targetRevision": "1.0.0",
        "helm": {"values": "nameOverride: account\nreplicaCount: 2\nenv:\n  LOG_LEVEL: info\n"}
      },
      "destination": {"server": "https://kubernetes.default.svc", "namespace": "dev"}
    },
    "status": {"sync": {"status": "Synced"}, "health": {"status": "Healthy"}}
  },
  {
    "metadata": {"name": "dev-router", "namespace": "argocd"},
    "spec": {
      "project": "core",
      "source": {
        "repoURL": "https://charts.interno/helm",
        "chart": "router",
        "targetRevision": "1.0.0",
        "helm": {"valuesObject": {"env": {
          "Acme.Router__AccountEndpoint": "http://account",
          "ORDERS_QUEUE_URL": "https://sqs.us-east-1.amazonaws.com/123456789012/orders",
          "LOG_LEVEL": "info"
        }}}
      },
      "destination": {"server": "https://kubernetes.default.svc", "namespace": "dev"}
    },
    "status": {"sync": {"status": "Synced"}, "health": {"status": "Healthy"}}
  }
]
